{
  "name": "Flowform_final",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "pnpm -r --filter @flowform/api --filter @flowform/web-app start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "6.0.2"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=18"
  }
}
